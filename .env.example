# ==========================================
# Google AI Studio (Gemini API) 設定
# ==========================================
# https://google.com で取得したAPIキーを入力してください
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==========================================
# 親御さん（ユーザー）の情報とキャラクター設定
# ==========================================
# アプリ画面に表示する親御さんの名前やニックネーム
PARENT_NAME=お母さん


# AIの口調やキャラクターの指示（例：優しくてフランクな関西弁、など）
AI_CHARACTER_PROMPT=親しみやすい口調で、1〜2文の短いメッセージで返答してください。高齢者にも分かりやすい言葉を使い、絵文字も交えてください。
